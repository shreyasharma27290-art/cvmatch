# ============================================================
# CVMatch – Environment Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# ── App ─────────────────────────────────────────────────────
APP_NAME=CVMatch
APP_ENV=development          # development | staging | production
APP_PORT=8000
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-in-production

# ── Database (PostgreSQL via Neon or Railway) ────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/cvmatch
# Example Neon URL:
# DATABASE_URL=postgresql+asyncpg://username:password@ep-xxx.us-east-2.aws.neon.tech/cvmatch

# ── AI APIs ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx

# ── Vector Database (Pinecone) ───────────────────────────────
PINECONE_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=cvmatch-jobs

# ── Cloud Storage (AWS S3 for resumes) ───────────────────────
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=ap-south-1
S3_BUCKET_NAME=cvmatch-resumes

# ── Job Source APIs ───────────────────────────────────────────
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token

INDEED_PUBLISHER_ID=your-indeed-publisher-id

# Naukri uses web scraping — no official API key needed
# Internshala uses web scraping — no official API key needed

# ── Auth (Clerk.dev) ─────────────────────────────────────────
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# ── Payments (Razorpay for ₹299/month premium) ──────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# ── Email (for notifications) ────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@cvmatch.in

# ── Frontend URL (for CORS) ───────────────────────────────────
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://cvmatch.vercel.app

# ── Rate Limiting ─────────────────────────────────────────────
FREE_PLAN_SCANS_PER_MONTH=3
FREE_PLAN_JOB_MATCHES=10
FREE_PLAN_CHAT_MESSAGES=10
PREMIUM_PRICE_INR=299
